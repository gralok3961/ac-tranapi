{
  "name": "hashtrion.transaction.api",
  "version": "1.0.0",
  "description": "Hashtrion transaction API server",
  "author": "hashtrion",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "TS_NODE_BASEURL=./dist node -r tsconfig-paths/register dist/server.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec \"ts-node -r tsconfig-paths/register\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "npm start",
    "test": "node --test tests/*.test.cjs",
    "test:compiled": "TEST_COMPILED=1 node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@azure/keyvault-secrets": "^4.8.0",
    "colorette": "^2.0.20",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "inversify": "^6.0.2",
    "inversify-express-utils": "^6.4.6",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "xrpl": "^4.5.0",
    "ripple-keypairs": "2.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.4.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
